# Copy to .env.local and fill in. Required vars are listed first.

# Supabase project URL (local stack: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key; NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted as an alias
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret (service role) key, server only; SUPABASE_SERVICE_ROLE_KEY is accepted as an alias
SUPABASE_SECRET_KEY=
# Canonical site URL used in emails, sitemap and share links
SITE_URL=http://localhost:3000
# Comma-separated allowlist of admin emails; required, an empty list admits nobody
ADMIN_EMAILS=

# Optional: Cloudflare Turnstile bot check on the public forms
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: Resend transactional email; without it outgoing email is logged, not sent
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Optional: address that receives instant notifications and the daily digest
ADMIN_NOTIFY_EMAIL=
# Optional: bearer token the cron scheduler sends to /api/cron/new-inquiries-digest (min 20 chars)
CRON_SECRET=
# Optional: Google Analytics measurement id
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: Stadia Maps API key for the basemap tiles (keyless works on localhost)
NEXT_PUBLIC_STADIA_API_KEY=
# Optional: map centre as "lat,lng"; defaults to the value in src/config/site.ts
NEXT_PUBLIC_MAP_CENTER=
# Optional: links shown on the support page
NEXT_PUBLIC_SUPPORT_STRIPE_LINK=
NEXT_PUBLIC_SUPPORT_ETRANSFER=

# Test only: admin credentials the Playwright admin specs log in with
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
